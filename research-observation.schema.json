{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIYucha Research Observation",
  "type": "object",
  "required": [
    "domain",
    "observed_at",
    "observations"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "vantage": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "value": {},
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
